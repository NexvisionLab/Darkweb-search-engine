[Unit]
Description=DarkNyx public Telegram ingest health check (fails when the feed is starved)
After=network.target

[Service]
Type=oneshot
User=darknyx
WorkingDirectory=/opt/darknyx/crawler
EnvironmentFile=/opt/darknyx/.env
ExecStart=/opt/darknyx/crawler/.venv/bin/python3 scripts/social_telegram_health.py --check
Nice=10
