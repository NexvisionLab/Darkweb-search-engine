# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore) - every value below that looks like a secret
# is a placeholder, not a working credential.

# --- Postgres (required) ---
POSTGRES_USER=darknyx
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_DB=darknyx
DB_HOST=127.0.0.1
DB_PORT=5432

# --- OpenSearch (required) ---
OPENSEARCH_HOST=127.0.0.1
OPENSEARCH_JAVA_OPTS="-Xms1g -Xmx1g"

# --- Valkey / Redis (required - rate limiting) ---
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379

# --- Tor proxy (required - the crawler routes every request through this) ---
# Points at the tor-privoxy-0 container's exposed HTTP proxy port.
TOR_PROXY=http://127.0.0.1:8118

# --- Admin API (required for the /admin/* moderation endpoints) ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me-to-a-random-token

# --- Session encryption (required only if you use authenticated crawling) ---
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=

# --- Local AI summarizer (optional - only needed for the on-demand summarize tool) ---
# Points at the llama.cpp server started by ops/systemd/darkweb-summarizer.service.
SUMMARIZER_URL=http://127.0.0.1:8081/v1/completions

# --- Weekly digest email (optional - leave blank to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM_EMAIL=digest@yourdomain.com

# --- Surface-web crawling (optional - most target sites need a residential proxy) ---
SURFACE_WEB_PROXY=
